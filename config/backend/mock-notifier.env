ENV_DB_URL=jdbc:mariadb://db:3306/notifier
ENV_DB_USERNAME=root
ENV_DB_PASSWORD=root

# Auth (users module): JWT signing + bootstrap admin
JWT_SECRET=mockJwtSecretForLocalDevelopmentOnly1234567890
JWT_EXPIRATION=86400000
USER_CREDENTIALS_EMAIL=test@test.se
USER_CREDENTIALS_PASSWORD=pass
USER_CREDENTIALS_PHONENUMBER=0701740605
USER_CREDENTIALS_MUNICIPALITYID=2281

ENV_SMS_SENDER_BASE_URL=http://api-service-sms-sender:8080
ENV_SMS_SENDER_TOKEN_URL=http://wiremock:8080/token
ENV_SMS_SENDER_CLIENT_ID=mock-client-id
ENV_SMS_SENDER_CLIENT_SECRET=mock-client-secret

ENV_TEAMS_SENDER_BASE_URL=http://api-service-teams-sender:8080
ENV_TEAMS_SENDER_TOKEN_URL=http://wiremock:8080/token
ENV_TEAMS_SENDER_CLIENT_ID=mock-client-id
ENV_TEAMS_SENDER_CLIENT_SECRET=mock-client-secret

# CSV import (csvimport module) — the mock Spring profile reads local files instead of SFTP
EMPLOYEE_BATCH_SIZE=200
ORGANIZATION_BATCH_SIZE=200
SFTP_USERNAME=mock
SFTP_PASSWORD=mock
SFTP_URL=mock
ORGANIZATION_FILE_NAME=OrgExport.csv
EMPLOYEE_FILE_NAME=EmpExport.csv
